# ---------------------------------------------------------------
# PatchWork Core Backend — Environment Variables
# Copy to .env and fill in values.
# ---------------------------------------------------------------

# Database (Supabase Postgres direct connection)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres
PORT=3000

# Supabase project (for Storage + Auth admin)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Anon key — used by requireAuth middleware to validate user JWTs via getUser()
SUPABASE_ANON_KEY=your_anon_key_here

# ----------------------------------------------------------
# Cloudflare R2 — image storage (replaces AWS S3)
# Mirrors the Cozy project R2 configuration.
# ----------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=patchwork-ports-stag
R2_PUBLIC_URL=https://your-r2-custom-domain.com

# ----------------------------------------------------------
# Cron job auth (cron-job.org → POST /api/cron/*)
# Set the same value in cron-job.org as Authorization: Bearer <value>
# ----------------------------------------------------------
CRON_SECRET=your_cron_secret_here

# ----------------------------------------------------------
# Critter bounty webhook
# ----------------------------------------------------------
WEBHOOK_URL=https://api.patchwork.local/webhook/critter-bounty
